# 飞书应用
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
# ws | http | both（本机推荐 ws，飞书选「长连接」）
FEISHU_TRANSPORT=ws

# 可选：仅允许这些 open_id（逗号分隔）；为空则不限制
# FEISHU_ALLOW_OPEN_IDS=ou_xxx,ou_yyy

# Cursor（也可本机先执行 agent login，不填 KEY）
# 获取: https://cursor.com/dashboard/api
CURSOR_API_KEY=
# 空 = 用账号/CLI 默认模型（一般与 IDE 默认一致）；要对齐 IDE 某模型时填 agent --list-models 里的 id
# CURSOR_MODEL=
# CURSOR_BIN=agent

# Kiro（也可本机先 kiro-cli login；Headless 推荐 API Key）
# 获取: https://app.kiro.dev → API Keys，或 kiro-cli 文档中的 api-key 流程
KIRO_API_KEY=
# 默认 Claude Opus 5；先用 kiro-cli chat --list-models 确认本机是否有该 id
KIRO_MODEL=claude-opus-5
# KIRO_BIN=kiro-cli
# 可写模式下会用 --trust-all-tools；只读时从下面列表去掉 write/bash
# KIRO_TRUST_TOOLS=fs_read,fs_write,execute_bash,grep

# 默认引擎与工作区
DEFAULT_ENGINE=cursor
DEFAULT_CWD=~/Code
# 要对齐 IDE Agent「能改代码」：true，或飞书里 /write on
DEFAULT_WRITE_MODE=false

# 超时与存储
AGENT_TIMEOUT_MS=300000
# SESSION_STORE_PATH=~/.config/feishu-coding-agent/sessions.json

# HTTP（transport=http/both 时）
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/feishu

# 企业代理（如需要；务必让飞书域名直连）
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=open.feishu.cn,localhost,127.0.0.1
